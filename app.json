{
  "expo": {
    "name": "KinoX Plus",
    "slug": "kinox-plus",
    "scheme": "kinoxplus",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "primaryColor": "#0047ab",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.kinoxplus.mobile",
      "backgroundColor": "#0a0a0a",
      "associatedDomains": [
        "applinks:kinoxplus.app",
        "applinks:kinoxplus.app",
        "applinks:kinoxplus.app",
        "applinks:kinoxplus.app"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "KinoX Plus uses your camera so friends can see you live in watch party rooms.",
        "NSMicrophoneUsageDescription": "KinoX Plus uses your microphone so friends can hear you live in watch party rooms.",
        "UIBackgroundModes": [
          "audio",
          "audio",
          "audio",
          "audio"
        ]
      }
    },
    "android": {
      "package": "app.kinoxplus.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0047ab",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
